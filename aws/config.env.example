# ============================================================
# POD pipeline — environment variable names (Lambda runtime)
#
# Values are set by CloudFormation (infra/stack.yaml) via
# aws/provision-stack.sh — do NOT bake secrets into the image.
# Never commit real DB passwords.
# ============================================================

# --- Trigger: PRIMARY path is event-driven, one trip at a time ---
# Sarathy invokes the function (async, InvocationType=Event) with:
#   {"trip_id": 12345, "pod_links": ["https://..."], "awb": "..."}
# TRIP_QUERY resolves that trip's POD rows; if it returns nothing the handler
# falls back to pod_links from the event. MUST keep the %(trip_id)s placeholder —
# it is bound as a query parameter, never string-interpolated.
TRIP_QUERY=SELECT awb, trip_id, pod FROM pod_manual_verification WHERE trip_id = %(trip_id)s

# Re-request de-dup: a link already scored within this window is not
# re-downloaded when the rider raises the request again. Keyed on the LINK, so
# replaced photos are always scored. 0 = never re-score a link.
RESCORE_LOOKBACK_DAYS=30

# A trip has a handful of images — don't spend 64 threads on it.
TRIP_MAX_DOWNLOAD_WORKERS=8

# --- Warm pool: keep N containers hot so scoring skips the cold start ---
WARM_FANOUT=3
WARM_HOLD_SECONDS=1.5

# --- Batch triggers (admin API / manual) ---
# Date range: {"start_date":"2026-08-01","end_date":"2026-08-20"}
RANGE_QUERY=SELECT awb, trip_id, pod FROM pod_manual_verification WHERE created_date BETWEEN %(start_date)s AND %(end_date)s
# Raw SQL in the event: {"query":"SELECT awb, trip_id, pod FROM ..."}
# Validated as a single read-only SELECT/WITH; set false to refuse it outright.
ALLOW_ADHOC_QUERY=true

# --- Source: batch/backfill only. SQL to read the day's POD rows from Postgres ---
# Must return an AWB column, a trip-id column, and a POD-links column
# (POD / pod / pod_link; comma-separated links are expanded).
# Runs against the same DB as PG_* below.
SOURCE_QUERY=SELECT awb, trip_id, pod FROM pod_manual_verification WHERE created_date = CURRENT_DATE

# --- Pipeline tuning (stack params: MaxDownloadWorkers, WindowSize, InferenceBatchSize) ---
MAX_DOWNLOAD_WORKERS=64      # concurrent image downloads (watch source-host 429s / NAT)
WINDOW_SIZE=800             # images held in memory per window (bounds peak memory)
INFERENCE_BATCH_SIZE=64

# --- Scoring ---
FLAG_THRESHOLD=0.7          # eval favours ~0.55-0.60 for precision-first penalising
IMAGENET_NORMALIZE=true     # REQUIRED: model trained with ImageNet norm; do NOT disable

# --- Resilience (self-continuation safety valve) ---
CONTINUATION_SAFETY_MS=90000
MAX_CONTINUATIONS=5

# --- Postgres ---
PG_HOST=db.xxxxxxxx.region.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=pod_classifier
PG_USER=postgres
PG_PASSWORD=REPLACE_ME

# --- Model (baked into the image) ---
MODEL_PATH=/opt/model/best.pt
INPUT_SIZE=224

# --- Provisioning examples (provision-stack.sh / deploy.sh exports) ---
# AWS_REGION=ap-south-1
# STACK_NAME=pod-scoring-prod
# STAGE=prod
# VPC_ID=vpc-xxx
# SUBNET_IDS=subnet-a,subnet-b
# SCORER_IMAGE_URI=account.dkr.ecr.region.amazonaws.com/repo:tag
# ECR_REPOSITORY=pod-pipeline
# TMP_EPHEMERAL_MB=512       # in-memory design uses no /tmp
