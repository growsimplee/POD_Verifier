# ============================================================
# POD pipeline — environment variable names (Lambda runtime)
#
# Values are set by CloudFormation (infra/stack.yaml) via
# aws/provision-stack.sh — do NOT bake anything secret into the image.
#
# There are no database variables here. pod_scores is sarathy's table,
# created by sarathy's Flyway migration V198__pod_scores.sql; this function
# has no driver, no credentials and no SQL. Everything it needs from the
# database it asks sarathy for over HTTP.
# ============================================================

# --- Sarathy: the only route to any data ---------------------------------
# Sarathy on the shared INTERNAL NLB — the same address logistic uses for it
# (url.sarathy.base). Sarathy listens on 9001 with no context path. Scheme,
# host and port only: the client appends /internal/pod-scoring itself.
#
#   GET  /internal/pod-scoring/trips/{tripId}   one trip's links + scored flags
#   GET  /internal/pod-scoring/trips?...        a page of trips for a backfill
#   POST /internal/pod-scoring/scores           write a batch of scores
#
# The NLB must be the INTERNAL one — it resolves to private addresses only
# (10.0.x on stage, 10.10.x on prod). /internal/pod-scoring carries no
# app-level token, exactly like the rest of sarathy's service-to-service
# surface, so a publicly routable address here would expose an
# unauthenticated write to pod_scores.
#
# prod: http://grow-simplee-nlb-prod-a264c46571856f67.elb.ap-south-1.amazonaws.com:9001
SARATHY_BASE_URL=http://grow-simplee-nlb-staging-0dff0c43a1132f00.elb.us-east-2.amazonaws.com:9001
SARATHY_TIMEOUT=15           # seconds per request
SARATHY_RETRIES=3            # attempts before the run fails
SARATHY_PAGE_SIZE=500        # rows per backfill page (sarathy caps at 2000)

# The re-request de-dup window is sarathy's, not ours — it decides which links
# already carry a score. Set it there as pod.scoring.rescore-lookback-days.

# --- Trigger: PRIMARY path is event-driven, one trip at a time ------------
# Sarathy invokes the function (async, InvocationType=Event) with:
#   {"trip_id": 12345, "pod_links": ["https://..."], "awb": "..."}
# The event's links win when it carries them — they are the trip as it was at
# the instant the rider raised the request. Sarathy is asked when the event has
# no links, and also when it has no AWB (a TRIP-<id> placeholder is not an AWB).

# A trip has a handful of images — don't spend 64 threads on it.
TRIP_MAX_DOWNLOAD_WORKERS=8

# --- Warm pool: keep N containers hot so scoring skips the cold start -----
WARM_FANOUT=3
WARM_HOLD_SECONDS=1.5

# --- Batch triggers (admin API / manual) ---------------------------------
# Date range: {"start_date":"2026-08-01","end_date":"2026-08-20"}
# Empty event {}: today. Both page through sarathy; neither carries SQL.

# --- Pipeline tuning (stack params: MaxDownloadWorkers, WindowSize, InferenceBatchSize) ---
MAX_DOWNLOAD_WORKERS=64      # concurrent image downloads (watch source-host 429s / NAT)
WINDOW_SIZE=800              # images held in memory per window (bounds peak memory)
INFERENCE_BATCH_SIZE=64

# --- Scoring -------------------------------------------------------------
FLAG_THRESHOLD=0.7           # eval favours ~0.55-0.60 for precision-first penalising
IMAGENET_NORMALIZE=true      # REQUIRED: model trained with ImageNet norm; do NOT disable

# --- Resilience (self-continuation safety valve) --------------------------
CONTINUATION_SAFETY_MS=90000
MAX_CONTINUATIONS=5

# --- Model (baked into the image) ----------------------------------------
MODEL_PATH=/opt/model/best.pt
INPUT_SIZE=224

# --- Provisioning examples (provision-stack.sh / deploy.sh exports) -------
# AWS_REGION=ap-south-1
# STACK_NAME=pod-scoring-prod
# STAGE=prod
# VPC_ID=vpc-xxx
# SUBNET_IDS=subnet-a,subnet-b
# SCORER_IMAGE_URI=account.dkr.ecr.region.amazonaws.com/repo:tag
# ECR_REPOSITORY=pod-pipeline
# TMP_EPHEMERAL_MB=512       # in-memory design uses no /tmp
